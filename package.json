{
  "name": "ai-expense-tracker",
  "version": "1.0.0",
  "description": "AI-powered expense tracker with GCP integration",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
